---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copy, otherLocale, routePath, type Locale } from "@/i18n";
import { infoPhotos } from "@/data/photos";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
---

<BaseLayout
  title="Info"
  description={c.meta.info}
  locale={locale}
  alternateHref={routePath("info", otherLocale(locale))}
  current="info"
  backdrop="marfil"
>
  <section class="about shell">
    <div class="about-photo" data-reveal>
      <Image src={infoPhotos.lead} alt="" widths={[480, 800]} sizes="(max-width: 760px) 100vw, 40vw" loading="eager" />
    </div>
    <div class="about-text">
      <p class="label muted">Raimundo</p>
      <h1 class="title">{c.info.title}</h1>
      <div class="prose lead">
        {c.info.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="process" aria-labelledby="process-title">
    <div class="shell process-head" data-reveal>
      <p class="label muted">{locale === "es" ? "Proceso" : "Process"}</p>
      <h2 id="process-title" class="title">{c.info.processTitle}</h2>
      <p class="lead">{c.info.processIntro}</p>
    </div>

    <ol class="steps">
      {
        c.info.steps.map((step, index) => (
          <li class="step" data-reveal style={`transition-delay:${index * 80}ms`}>
            <div class="step-photo">
              <Image src={infoPhotos.steps[index]!} alt="" widths={[320, 520]} sizes="(max-width: 760px) 70vw, 18vw" />
            </div>
            <p class="label step-number muted">0{index + 1}</p>
            <h3 class="title-sm">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="four-c shell" aria-label="4 C" data-reveal>
    <p class="slogan">
      {
        c.fourC.map((word, index) => (
          <>
            {index > 0 && <span class="dot" aria-hidden="true">·</span>}
            <span>{word}</span>
          </>
        ))
      }
    </p>
    <p class="muted">{c.info.fourCIntro}</p>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding-top: clamp(2rem, 6vw, 5rem);
  }

  .about-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .about-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-text {
    display: grid;
    gap: 1.5rem;
  }

  .process {
    margin-top: clamp(6rem, 14vw, 12rem);
  }

  .process-head {
    display: grid;
    gap: 1.25rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    width: min(100%, 1440px);
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    padding-inline: var(--gutter);
  }

  .step {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .step-photo {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 0.6rem;
  }

  .step-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .four-c {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(6rem, 14vw, 12rem);
    text-align: center;
    justify-items: center;
  }

  .slogan {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.2em 0.5em;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5.5vw, 5rem);
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .dot {
    color: var(--ambar);
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }

    /* Process steps become a sideways swipe row */
    .steps {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 70%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-bottom: 1rem;
    }

    .step {
      scroll-snap-align: start;
    }

    .slogan {
      flex-direction: column;
    }

    .slogan .dot {
      display: none;
    }
  }
</style>
