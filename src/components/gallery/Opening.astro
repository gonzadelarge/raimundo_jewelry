---
import { Image } from "astro:assets";
import { copy, type Locale } from "@/i18n";
import { openingPhotos } from "@/data/photos";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
// Parallax rate per tile, in tile order. Negative means the tile climbs as the page goes
// down, so the wall pulls apart while you scroll, the same way the two photos of a gallery
// spread separate. The spread between the rates is what you see: 0.08 against 0.30 is more
// than 200px of daylight by the time the hero leaves the screen.
// Every tile moves away from the text and the claim moves the other way, so the title is
// never buried. Tile 4 is the smallest and furthest back, tile 5 is in front.
const tileParallax = [-0.2, -0.26, -0.14, -0.3, -0.08];
---

<section class="opening" aria-labelledby="opening-title">
  <div class="collage" aria-hidden="true">
    {
      openingPhotos.map((photo, index) => (
        <div class={`tile tile-${index + 1}`} data-reveal data-parallax={tileParallax[index]} data-parallax-zero style={`transition-delay:${index * 70}ms`}>
          <Image src={photo} alt="" widths={[240, 320, 420, 560, 760]} sizes="(max-width: 760px) 50vw, 30vw" loading={index < 3 ? "eager" : "lazy"} />
        </div>
      ))
    }
  </div>

  <div class="claim shell" data-parallax="0.06" data-parallax-zero>
    <h1 id="opening-title" class="label claim-main">{c.slogan}</h1>
    <p class="label claim-origin"><span class="star" aria-hidden="true"></span> {c.origin}</p>
    <p class="intro muted">{c.home.intro}</p>
  </div>
</section>

<style>
  /* ------------------------------------------------------------------ *
   * Shared: what the hero is made of. No sizes and no positions here.
   * The two layouts below are separate on purpose, so a change to one
   * cannot move the other. Each sets its own --collage-w, tile grid and
   * overlap. Nothing is measured against the viewport height except the
   * one cap in each --collage-w.
   * ------------------------------------------------------------------ */

  .opening {
    /* The same column the gallery spreads use, not the 1440px of .shell. */
    --hero-col: min(100%, 1280px);
    display: grid;
    align-content: center;
  }

  .collage {
    /* In the flow, not laid over the hero. The claim comes right after it and pulls up by
       a set amount, so the overlap between photos and title is always the same. */
    position: relative;
    width: var(--collage-w);
    /* Starts on the left edge of the gallery column, not in the middle of the screen. */
    margin-inline: calc(50% - var(--hero-col) / 2) auto;
  }

  .tile {
    position: absolute;
    overflow: hidden;
    /* The tiles overlap, so each one needs to lift off the one behind it. */
    box-shadow: var(--shadow-collage);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stacking is the same in both layouts: the beads box covers the earrings, and the worn
     photo covers both. The claim sits at 10, so every tile stays under the text. */
  .tile-1 { z-index: 1; }
  .tile-2 { z-index: 2; }
  .tile-3 { z-index: 4; }
  .tile-4 { z-index: 3; }
  .tile-5 { z-index: 5; }

  .tile-1,
  .tile-4 { aspect-ratio: 3 / 4; }
  .tile-2,
  .tile-5 { aspect-ratio: 4 / 3; }
  .tile-3 { aspect-ratio: 4 / 5; }

  .claim {
    position: relative;
    z-index: 10;
    display: grid;
    gap: 0.6rem;
    width: var(--hero-col);
    margin-inline: auto;
  }

  .claim-main {
    /* .label sets 0.16em, which tears the words apart at this size. */
    letter-spacing: 0.05em;
    line-height: 1.05;
    /* Set in em, not percent, so the line breaks hold on every screen:
       LUXURY JEWELRY / UNDERGROUND / SPIRIT. The longest line is 8.8em and the shortest
       pair that has to break, UNDERGROUND SPIRIT, is 11.2em, so 9.5em clears both.
       No `text-wrap: balance` here, because balancing undoes that shape. */
    max-width: 9.5em;
  }

  .intro {
    max-width: 30rem;
    margin-top: 0.6rem;
  }

  /* ------------------------------------------------------------------ *
   * DESKTOP, 761px and up. A wide wall on the left of the column, the
   * claim under it. Three numbers run the whole thing:
   *   --collage-w           how wide the wall is,
   *   .collage aspect-ratio how tall,
   *   .claim margin-top     how far the title rides into the wall.
   * ------------------------------------------------------------------ */

  @media (min-width: 761px) {
    .opening {
      /* The full column, unless the screen is too short for it. 1.81 is the wall's own
         ratio, so the cap reads as "the wall is never taller than 54svh". */
      --collage-w: min(var(--hero-col), calc(54svh * 1.81));
      min-height: calc(100svh - var(--header-h));
      padding-block: clamp(2rem, 5vh, 4rem);
    }

    .collage {
      aspect-ratio: 1.81;
    }

    .tile-1 { left: 0;     top: 21.7%; width: 21.1%; }
    .tile-2 { left: 13.3%; top: 0;     width: 26%; }
    .tile-3 { left: 36.1%; top: 14.1%; width: 32.8%; }
    .tile-4 { left: 67.3%; top: 1.7%;  width: 15.5%; }
    .tile-5 { left: 68.6%; top: 57.5%; width: 31.3%; }

    /* 2% of the wall's width, about a third of a line. Only the first line of the title
       reaches the photos, and only tile 3, which is why tile 3 must stay a light photo. */
    .claim {
      margin-top: calc(var(--collage-w) * -0.02);
    }

    .claim-main {
      font-size: clamp(2.4rem, 5.2vw, 4.4rem);
    }

    .intro {
      font-size: 0.9rem;
    }
  }

  /* ------------------------------------------------------------------ *
   * MOBILE, 760px and down. The same five photos and the same three
   * knobs, but the wall is turned on its side: taller than it is wide,
   * and the tiles walk down it in a zigzag.
   * ------------------------------------------------------------------ */

  @media (max-width: 760px) {
    .opening {
      /* The box is 1.24 times as tall as it is wide, so the wall runs down the phone
         column instead of sitting in a square. The cap is written as a height, 60svh
         divided by that ratio, so a short phone shrinks the wall and not the text. */
      --collage-w: min(100%, calc(60svh / 1.24));
      min-height: calc(92svh - var(--header-h));
      padding-block: clamp(1.5rem, 4vh, 3rem);
    }

    .collage {
      aspect-ratio: 1 / 1.24;
    }

    /* A zigzag down the column, not a pile. Each tile is smaller than the desktop share
       of its box and touches its neighbour by a few percent only, so marble shows between
       them. The right side is left open between tiles 4 and 5 on purpose. */
    .tile-1 { left: 8%;  top: 15%; width: 36%; }
    .tile-2 { left: 32%; top: 0;    width: 42%; }
    .tile-3 { left: 22%; top: 50%;  width: 50%; }
    .tile-4 { left: 66%; top: 20%;  width: 26%; }
    /* Tile 5 runs about 7% past the bottom of the box, so the rings sit beside the first
       line of the title. Lower its top to pull it back inside. */
    .tile-5 { left: 60%; top: 85%;  width: 36%; }

    .claim {
      margin-top: calc(var(--collage-w) * -0.04);
    }

    .claim-main {
      font-size: clamp(2rem, 9.5vw, 2.9rem);
    }

    .intro {
      font-size: 0.95rem;
    }
  }
</style>
