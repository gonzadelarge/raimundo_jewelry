---
import { Image } from "astro:assets";
import { copy, type Locale } from "@/i18n";
import { openingPhotos } from "@/data/photos";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
---

<section class="opening" aria-labelledby="opening-title">
  <div class="collage" aria-hidden="true">
    {
      openingPhotos.map((photo, index) => (
        <div class={`tile tile-${index + 1}`} data-reveal style={`transition-delay:${index * 70}ms`}>
          <Image src={photo} alt="" widths={[240, 320, 420, 560, 760]} sizes="(max-width: 760px) 46vw, 26vw" loading={index < 3 ? "eager" : "lazy"} />
        </div>
      ))
    }
  </div>

  <div class="claim shell">
    <h1 id="opening-title" class="label claim-main">{c.slogan}</h1>
    <p class="label claim-origin"><span class="star" aria-hidden="true"></span> {c.origin}</p>
    <p class="intro muted">{c.home.intro}</p>
  </div>
</section>

<style>
  .opening {
    /* The same column the gallery spreads use, not the 1440px of .shell. The claim text
       then starts on the gallery's left edge instead of hanging off to the side, and the
       collage narrows with it, so the text lands on the photos. */
    --hero-col: min(100%, 1280px);
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-content: end;
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }

  .collage {
    position: absolute;
    inset: 0;
    width: var(--hero-col);
    margin-inline: auto;
    pointer-events: none;
  }

  .tile {
    position: absolute;
    overflow: hidden;
    /* The tiles overlap, so each one needs to lift off the one behind it. */
    box-shadow: var(--shadow-collage);
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A wall, not a row. Every tile overlaps at least one neighbour, and the sizes run from
     12% to 25% of the collage box so the wall has a clear near and far.
     `z-index` sets the stacking on purpose: the claim sits at 10, so tiles stay below it.
     Tile 8 is the only one under the claim text, so it must stay a light photo. */
  .tile-1 { left: 1%;  top: 14%; width: 13%; aspect-ratio: 3 / 4; z-index: 1; }
  .tile-2 { left: 11%; top: 2%;  width: 20%; aspect-ratio: 4 / 3; z-index: 2; }
  .tile-3 { left: 30%; top: 11%; width: 25%; aspect-ratio: 4 / 5; z-index: 6; }
  .tile-4 { left: 52%; top: 3%;  width: 12%; aspect-ratio: 3 / 4; z-index: 3; }
  .tile-5 { left: 62%; top: 14%; width: 22%; aspect-ratio: 4 / 3; z-index: 4; }
  .tile-6 { left: 60%; top: 38%; width: 19%; aspect-ratio: 4 / 5; z-index: 7; }
  .tile-7 { left: 4%;  top: 36%; width: 15%; aspect-ratio: 3 / 4; z-index: 5; }
  .tile-8 { left: 16%; top: 55%; width: 23%; aspect-ratio: 4 / 3; z-index: 8; }
  .tile-9 { left: 74%; top: 58%; width: 16%; aspect-ratio: 3 / 4; z-index: 9; }

  .claim {
    position: relative;
    z-index: 10;
    display: grid;
    gap: 0.6rem;
    width: var(--hero-col);
    margin-inline: auto;
  }

  .claim-main {
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
  }

  .intro {
    max-width: 30rem;
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .opening {
      min-height: calc(92svh - var(--header-h));
    }

    /* Five tiles on mobile, one per piece, overlapping like the desktop wall. */
    .tile-1 { left: 2%;  top: 3%;  width: 40%; }
    .tile-2 { left: 34%; top: 10%; width: 50%; }
    .tile-3 { left: 14%; top: 27%; width: 46%; }
    .tile-4 { left: 56%; top: 40%; width: 30%; }
    .tile-5 { left: 30%; top: 55%; width: 44%; }

    .tile-6,
    .tile-7,
    .tile-8,
    .tile-9 { display: none; }
  }
</style>
