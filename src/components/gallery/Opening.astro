---
import { Image } from "astro:assets";
import { copy, type Locale } from "@/i18n";
import { openingPhotos } from "@/data/photos";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = copy[locale];
---

<section class="opening" aria-labelledby="opening-title">
  <div class="collage" aria-hidden="true">
    {
      openingPhotos.map((photo, index) => (
        <div class={`tile tile-${index + 1}`} data-reveal style={`transition-delay:${index * 90}ms`}>
          <Image src={photo} alt="" widths={[320, 520, 760]} sizes="(max-width: 760px) 50vw, 26vw" loading={index < 3 ? "eager" : "lazy"} />
        </div>
      ))
    }
  </div>

  <div class="claim shell">
    <h1 id="opening-title" class="label claim-main">{c.slogan}</h1>
    <p class="label claim-origin"><span class="star" aria-hidden="true"></span> {c.origin}</p>
    <p class="intro muted">{c.home.intro}</p>
  </div>
</section>

<style>
  .opening {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-content: end;
    padding-bottom: clamp(3rem, 8vh, 6rem);
  }

  .collage {
    position: absolute;
    inset: 0;
    width: min(100%, 1440px);
    margin-inline: auto;
    pointer-events: none;
  }

  .tile {
    position: absolute;
    overflow: hidden;
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Loose collage, Aristizabal style. Positions in % of the first screen. */
  .tile-1 { left: 6%; top: 18%; width: 17%; aspect-ratio: 3 / 4; }
  .tile-2 { left: 27%; top: 6%; width: 22%; aspect-ratio: 4 / 3; }
  .tile-3 { left: 44%; top: 30%; width: 19%; aspect-ratio: 4 / 5; z-index: 1; }
  .tile-4 { left: 66%; top: 10%; width: 14%; aspect-ratio: 3 / 4; }
  .tile-5 { left: 78%; top: 36%; width: 16%; aspect-ratio: 3 / 4; }

  .claim {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.6rem;
    width: 100%;
  }

  .claim-main {
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
  }

  .intro {
    max-width: 30rem;
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .opening {
      min-height: calc(92svh - var(--header-h));
    }

    .tile-1 { left: 4%; top: 6%; width: 44%; }
    .tile-2 { left: 52%; top: 14%; width: 44%; }
    .tile-3 { left: 26%; top: 34%; width: 40%; }
    .tile-4,
    .tile-5 { display: none; }
  }
</style>
