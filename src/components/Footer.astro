---
import Seal from "@/components/brand/Seal.astro";
import { copy, routePath, ui, type Locale, type RouteKey } from "@/i18n";
import { site } from "@/data/site";

interface Props {
  locale: Locale;
  current?: RouteKey | "piece";
}

const { locale, current } = Astro.props;
const t = ui[locale];
const c = copy[locale];

// Info prints the 4 C in full, so the footer would say them twice on that page.
// There it carries a contact link instead.
const showFourC = current !== "info";
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p class="label origin">
      <Seal class="seal" title="Raimundo" />
      {t.footer.origin}
    </p>

    {
      showFourC ? (
        <p class="slogan label">
          {c.fourC.map((word, index) => (
            <>
              {index > 0 && (
                <span class="dot" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{word}</span>
            </>
          ))}
        </p>
      ) : (
        <a class="label arrow-link middle-link" href={routePath("contact", locale)}>
          {t.nav.contact}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      )
    }

    <ul class="links">
      <li><a class="label" href={site.instagram} target="_blank" rel="noreferrer">Instagram</a></li>
      <li><a class="label" href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(5rem, 12vw, 10rem);
    border-top: 1px solid var(--line);
  }

  /* One row on desktop. The side columns are both 1fr, so the 4 C sit in the middle of the
     page and not in the middle of the space left over. */
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem 1.5rem;
    padding-block: 1.75rem max(1.5rem, env(safe-area-inset-bottom));
  }

  .footer-inner > * {
    min-width: 0;
  }

  .origin {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
  }

  .origin :global(.seal) {
    width: 1.1rem;
    height: auto;
  }

  /* One line, always. The 4 C are the widest block, so they take the size that lets the
     three blocks share the row, and they never wrap. */
  .slogan {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 0.35rem 0.7rem;
    font-size: clamp(0.6rem, 0.95vw, 1rem);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .dot {
    color: var(--ambar);
  }

  /* The link takes the place of the 4 C, so it sits in the middle column. */
  .middle-link {
    justify-self: center;
    white-space: nowrap;
  }

  .links {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem 1.5rem;
    white-space: nowrap;
  }

  /* The footer is one row or one column, never something in between. Below 900px the three
     blocks cannot share a line at a readable size, so they stack. This is the only place in
     the site with a breakpoint other than 760px. */
  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 1.25rem;
      text-align: center;
    }

    .slogan {
      flex-wrap: wrap;
      white-space: normal;
      font-size: clamp(0.8rem, 1.6vw, 1rem);
    }

    .links {
      justify-content: center;
    }
  }
</style>
