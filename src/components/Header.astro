---
import Logo from "@/components/brand/Logo.astro";
import Seal from "@/components/brand/Seal.astro";
import { routePath, otherLocale, ui, type Locale, type RouteKey } from "@/i18n";
import { site } from "@/data/site";

interface Props {
  locale: Locale;
  current?: RouteKey | "piece";
  alternateHref: string;
}

const { locale, current, alternateHref } = Astro.props;
const t = ui[locale];
const links = [
  { key: "info", label: t.nav.info },
  { key: "baixo", label: t.nav.baixo },
  { key: "contact", label: t.nav.contact },
] as const;
const other = otherLocale(locale);
---

<header class="site-header" data-header transition:name="site-header" transition:animate="none">
  <div class="bar">
    <a class="home" href={routePath("home", locale)} aria-label={t.home}>
      <Logo class="logo" title="Raimundo" />
      <Seal class="seal" title="Raimundo" />
    </a>

    <nav class="nav" aria-label="Principal">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                class="label nav-link"
                href={routePath(link.key, locale)}
                aria-current={current === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="label nav-link lang" href={alternateHref} hreflang={other} lang={other} data-astro-history="replace">
            <span aria-hidden="true">{locale.toUpperCase()} / <b>{other.toUpperCase()}</b></span>
            <span class="sr-only">{t.switchTo}</span>
          </a>
        </li>
      </ul>
    </nav>

    <button class="label menu-button" type="button" data-menu-open aria-haspopup="dialog">
      {t.menu}
    </button>
  </div>

  <dialog class="mobile-menu" data-menu aria-label={t.menu}>
    <div class="mobile-top">
      <a class="home" href={routePath("home", locale)} aria-label={t.home} data-menu-link>
        <Seal class="seal-menu" title="Raimundo" />
      </a>
      <button class="label" type="button" data-menu-close>{t.close}</button>
    </div>

    <ul class="mobile-links">
      {
        links.map((link, index) => (
          <li style={`--i:${index}`}>
            <a
              href={routePath(link.key, locale)}
              aria-current={current === link.key ? "page" : undefined}
              data-menu-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mobile-bottom">
      <a class="label" href={alternateHref} hreflang={other} lang={other} data-menu-link data-astro-history="replace">
        {t.switchTo}
      </a>
      <a class="label" href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
      <a class="label" href={`mailto:${site.email}`}>Email</a>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--fg);
    transition:
      background-color 300ms ease,
      box-shadow 300ms ease;
  }

  .site-header[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 1440px);
    height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .home {
    display: block;
    color: var(--fg);
  }

  .home :global(.logo) {
    display: block;
    width: 9.5rem;
    height: auto;
  }

  .home :global(.seal) {
    display: none;
    width: 1.6rem;
    height: auto;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }

  .nav-link {
    position: relative;
    padding-block: 0.4rem;
  }

  .nav-link::after {
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms var(--ease-out);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .lang {
    color: var(--muted);
  }

  .lang b {
    color: var(--fg);
    font-weight: 400;
  }

  .menu-button {
    display: none;
    padding: 0.75rem 0 0.75rem 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Mobile menu overlay ---------- */

  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) max(1.5rem, env(safe-area-inset-bottom));
    border: 0;
    color: var(--marfil);
    background:
      linear-gradient(rgb(17 17 17 / 0.62), rgb(17 17 17 / 0.62)),
      var(--marble-dark) center / cover no-repeat,
      var(--carbon);
  }

  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
    animation: menu-in 320ms var(--ease-out) both;
  }

  .mobile-menu.is-closing {
    animation: menu-out 220ms ease both;
  }

  .mobile-menu::backdrop {
    background: transparent;
  }

  .mobile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding-top: env(safe-area-inset-top);
  }

  .mobile-top button {
    padding: 0.75rem 0 0.75rem 1rem;
  }

  .mobile-top .home {
    color: var(--marfil);
  }

  .home :global(.seal-menu) {
    width: 1.6rem;
    height: auto;
  }

  .mobile-links {
    display: grid;
    gap: 0.5rem;
    margin-block: auto;
  }

  .mobile-links a {
    display: block;
    padding-block: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 13vw, 4rem);
    letter-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .mobile-links a[aria-current="page"] {
    color: var(--ambar);
  }

  .mobile-menu[open] .mobile-links li {
    animation: link-in 520ms calc(120ms + var(--i) * 70ms) var(--ease-out) both;
  }

  .mobile-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(243 239 231 / 0.2);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-out {
    to {
      opacity: 0;
    }
  }

  @keyframes link-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @media (max-width: 760px) {
    :root {
      --header-h: 3.75rem;
    }

    .home :global(.logo),
    .nav {
      display: none;
    }

    .home :global(.seal),
    .menu-button {
      display: block;
    }
  }
</style>
