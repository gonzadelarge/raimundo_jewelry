---
import "@fontsource-variable/montserrat";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { htmlLang, otherLocale, ui, type Locale, type RouteKey } from "@/i18n";
import marfil from "@/assets/backgrounds/marmol_marfil.png";
import blanco from "@/assets/backgrounds/marmol_blanco.png";
import negro from "@/assets/backgrounds/marmol_negro.png";
import burdeos from "@/assets/backgrounds/marmol_burdeos.png";

// negro is reserved for El Baixo. Piece pages use blanco.
export type Backdrop = "marfil" | "blanco" | "negro" | "negro-soft" | "burdeos";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternateHref: string;
  current?: RouteKey | "piece";
  backdrop?: Backdrop;
}

const { title, description, locale, alternateHref, current, backdrop = "marfil" } = Astro.props;

const marbles = { marfil, blanco, negro, burdeos };
const source = backdrop === "negro-soft" ? "negro" : backdrop;
const [marble, marbleDark] = await Promise.all([
  getImage({ src: marbles[source], format: "webp", width: 1024, quality: 72 }),
  getImage({ src: negro, format: "webp", width: 1024, quality: 72 }),
]);

const theme = backdrop === "marfil" || backdrop === "blanco" ? "light" : "dark";
const veil = backdrop === "negro-soft" ? "soft" : undefined;
const pageTitle = title ? `${title} · Raimundo` : "Raimundo · Luxury jewelry with an underground spirit";
const other = otherLocale(locale);
const t = ui[locale];
---

<!doctype html>
<html
  lang={htmlLang[locale]}
  data-theme={theme}
  data-veil={veil}
  style={`--marble:url(${marble.src});--marble-dark:url(${marbleDark.src})`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content={theme === "light" ? "#F3EFE7" : "#111111"} />
    <link rel="alternate" hreflang={other} href={alternateHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/carla-sans/carla-sans.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body data-page={current}>
    <a class="skip-link label" href="#main">{t.skip}</a>
    <div class="backdrop" aria-hidden="true"></div>
    <Header locale={locale} current={current} alternateHref={alternateHref} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      import "@/scripts/motion";
      import "@/scripts/menu";
    </script>
  </body>
</html>
